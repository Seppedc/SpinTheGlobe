# Normalise text, keep Unity YAML diff-friendly
* text=auto
*.cs      text diff=csharp
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.meta    text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.asmdef  text eol=lf

# Binary assets (switch these to "filter=lfs diff=lfs merge=lfs -text" once Git LFS is installed)
*.blend  binary
*.fbx    binary
*.png    binary
*.jpg    binary
*.psd    binary
*.exr    binary
*.wav    binary
*.mp3    binary
*.zip    binary
*.xlsx   binary
